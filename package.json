    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "npx expo lint --max-warnings=0",
    "type-check": "npx tsc --noEmit",
    "prepare": "husky",
    "export-icons-native": "npx @svgr/cli --native --typescript --template svgr-template.js --no-index --expand-props none --svg-props \"width={HS(size)},height={VS(size)},style={style},viewBox=0 0 24 24\" --replace-attr-values \"currentColor={color}\" --out-dir src/components/icons/components -- src/assets/icons && sed -i.bak '/xmlns=/d;/import \\* as React/d' src/components/icons/components/*.tsx && rm src/components/icons/components/*.bak"
